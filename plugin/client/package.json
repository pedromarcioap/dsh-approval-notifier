{
  "name": "dsh-plugin-approval-notifier-client",
  "description": "Browser half of the DSH approval notifier: turns pending interactions into native notifications",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notifications",
    "approval"
  ],
  "license": "MIT",
  "author": "Pedro Marcio",
  "homepage": "https://github.com/pedromarcioap/dsh-approval-notifier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedromarcioap/dsh-approval-notifier.git",
    "directory": "plugin/client"
  },
  "bugs": {
    "url": "https://github.com/pedromarcioap/dsh-approval-notifier/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
